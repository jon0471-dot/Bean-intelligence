 <select id=\"task-priority\">"},{"type":"add","text":"                            <option value=\"low\">Low</option>"},{"type":"add","text":"                            <option value=\"medium\" selected>Medium</option>"},{"type":"add","text":"                            <option value=\"high\">High</option>"},{"type":"add","text":"                        </select>"},{"type":"add","text":"                    </div>"},{"type":"add","text":"                    "},{"type":"add","text":"                    <div class=\"form-group\">"},{"type":"add","text":"                        <label for=\"task-due-date\">Due Date</label>"},{"type":"add","text":"                        <input type=\"date\" id=\"task-due-date\">"},{"type":"add","text":"                    </div>"},{"type":"add","text":"                    "},{"type":"add","text":"                    <button type=\"submit\" class=\"btn btn-primary\">Add Task</button>"},{"type":"add","text":"                </form>"},{"type":"add","text":"            </section>"},{"type":"add","text":"            "},{"type":"add","text":"            <section class=\"task-controls\">"},{"type":"add","text":"                <div class=\"filter-buttons\">"},{"type":"add","text":"                    <button class=\"btn filter-btn active\" data-filter=\"all\">All Tasks</button>"},{"type":"add","text":"                    <button class=\"btn filter-btn\" data-filter=\"active\">Active</button>"},{"type":"add","text":"                    <button class=\"btn filter-btn\" data-filter=\"completed\">Completed</button>"},{"type":"add","text":"                    <button class=\"btn filter-btn\" data-filter=\"high\">High Priority</button>"},{"type":"add","text":"                </div>"},{"type":"add","text":"                "},{"type":"add","text":"                <div class=\"stats-bar\">"},{"type":"add","text":"                    <div class=\"stat\">"},{"type":"add","text":"                        <span class=\"stat-label\">Total:</span>"},{"type":"add","text":"                        <span class=\"stat-value\" id=\"stat-total\">0</span>"},{"type":"add","text":"                    </div>"},{"type":"add","text":"                    <div class=\"stat\">"},{"type":"add","text":"                        <span class=\"stat-label\">Active:</span>"},{"type":"add","text":"                        <span class=\"stat-value\" id=\"stat-active\">0</span>"},{"type":"add","text":"                    </div>"},{"type":"add","text":"                    <div class=\"stat\">"},{"type":"add","text":"                        <span class=\"stat-label\">Completed:</span>"},{"type":"add","text":"                        <span class=\"stat-value\" id=\"stat-completed\">0</span>"},{"type":"add","text":"                    </div>"},{"type":"add","text":"                </div>"},{"type":"add","text":"            </section>"},{"type":"add","text":"            "},{"type":"add","text":"            <section class=\"task-list\">"},{"type":"add","text":"                <h2>Tasks</h2>"},{"type":"add","text":"                <div id=\"task-container\">"},{"type":"add","text":"                    <!-- Tasks will be dynamically added here -->"},{"type":"add","text":"                </div>"},{"type":"add","text":"            </section>"},{"type":"add","text":"        </main>"},{"type":"add","text":"    </div>"},{"type":"add","text":"    "},{"type":"add","text":"    <script src=\"app.js\"></script>"},{"type":"add","text":"</body>"},{"type":"add","text":"</html>"}]}],"files":[{"path":"main.html","origin":"generated"}]}

