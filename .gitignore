# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
# The LAXII local engine adapter is REAL source code, not a local artifact.
# The bare local-* rule above silently ignored it (git check-ignore verified),
# so it could never be committed and its absence broke the build with
# "Module not found: Can't resolve '@/lib/laxii/local-adapter'".
!src/lib/laxii/local-adapter.ts
# M26.2/M26.3 (same class of bug caught at both reviews): these are REAL
# source files and directories of the local inference lanes — never local
# artifacts. The bare local-* rule above silently ignored them, so a fresh
# clone missed them and the build broke ("Module not found:
# '@/lib/media/local-models'", the llama.cpp desktop-engine client imported
# by the committed device-capability manager, etc.) while the sandbox —
# where the files exist on disk — built fine. Verified with git check-ignore.
!src/lib/laxii/local-edit.ts
!src/lib/local-engine/
!src/lib/media/local-models.ts
!src/app/api/laxii/local-models/
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# DB backups of the isolated verification environment (never commit DB backups)
scripts/giftz-verify-out/verify.db.backup-*.db
scripts/e2e-verify-out/verify.db.backup-*.db

# BEAN Intelligence local secrets and runtime data
.env*
!.env.example

# Local databases and backups
db/custom.db
db/custom.db.*
db/*.db
db/*.db-*

# Generated execution artifacts
sandbox-runs/

# Generated media and uploaded files
storage/
upload/

# Local logs
*.log

# Isolated verification environment runtime DBs (never commit)
scripts/e2e-verify-out/verify.db
scripts/giftz-verify-out/verify.db

# Runtime PID files
*.pid

# Agent/tool runtime outputs
tool-results/

# Historical dev server log snapshot
dev.log*

# Local history backups (never commit)
backup/

# LAXII/JAZMII restoration live-run artifacts: session cookie, generated
# media and DB runtime files are never committed (harness + evidence text only)
scripts/laxii-jazmii-restore-out/cookie.txt
scripts/laxii-jazmii-restore-out/*.mp4
scripts/laxii-jazmii-restore-out/*.png
scripts/laxii-jazmii-restore-out/*.jpg
scripts/laxii-jazmii-restore-out/*.db
__pycache__/

# M22 acceptance harness runtime DB (never commit the verification database)
scripts/m22-out/*.db
scripts/m22-out/*.db-*
# M23 acceptance harness runtime DB (never commit the verification database)
scripts/m23-out/*.db
scripts/m23-out/*.db-*

# M24 validation runtime artifacts: fixture build outputs and extracted
# evidence copies stay out of git (the verified ZIPs and screenshots are
# committed as evidence instead)
validation/m24/fixtures/*/dist/
validation/m24/evidence/extracted/
validation/m24/evidence/independent-build/

# M26 release-safety hardening: the f0b47ad auto-commit sweep committed
# scripts/.github_device_code ("sensitive — never committed" per M25_RESULTS §2),
# a db/backups snapshot and cURL cookie jars. These patterns make every future
# sweep skip them. The existing backups stay preserved on LOCAL-only refs
# (backup/m26-baseline-auto-commit) and are never pushed.
scripts/.github_device_code
scripts/**/*cookies*.txt
db/backups/
db/*.db
db/*.db-*

# M26.1 hardening (supersedes the M26 sweep scope): 7 more session-token
# files were found in scripts/e2e-out with non-"cookie" names (c2.txt,
# cg-ck*.txt, pipeline-ck*.txt, uc*.txt — introduced by a634fcf, missed by
# the M26 *cookie* filter, removed from HEAD in M26.1). Every E2E output
# directory may hold live session material or harness DBs: ignore all
# generated E2E output trees wholesale and any DB snapshot under scripts/.
scripts/e2e-out/*.txt
scripts/*-out/*.db
scripts/*-out/*.db-*
scripts/*.db
scripts/e2e-verify-out/verify.db
scripts/giftz-verify-out/verify.db
public/workers
src/workers/node_modules
src/workers/bun.lock*
