# BEAN Intelligence — environment template (NAMES ONLY; fill values locally, never commit real values)

# Core (required)
DATABASE_URL=

# Provider routing (required for hosted provider capabilities)
BEAN_PROVIDER_OPENAI_API_KEY=
BEAN_PROVIDER_OPENAI_BASE_URL=
BEAN_PROVIDER_OPENAI_MODEL=
BEAN_LLAMACPP_API_KEY=
BEAN_LLAMACPP_BASE_URL=
BEAN_LLAMACPP_MODEL=
LAXII_PROVIDER=

# LAXII workers (optional, defaults exist)
LAXII_WORKER_PYTHON=
LAXII_WORKER_MODELS_DIR=

# CODE GIETZ sandbox (optional, defaults exist)
BEAN_SANDBOX_RUNTIME=
BEAN_SANDBOX_PYTHON=
BEAN_SANDBOX_DISABLE_ISOLATION=
BEAN_SANDBOX_RETENTION_HOURS=
BEAN_SANDBOX_RLIMIT_AS=
BEAN_SANDBOX_RLIMIT_CPU=
BEAN_SANDBOX_RLIMIT_FSIZE=
BEAN_SANDBOX_RLIMIT_NOFILE=
BEAN_SANDBOX_RLIMIT_NPROC=

# Tuning knobs (optional timeouts/budgets/limits)
BEAN_IMAGE_PROBE_TIMEOUT_MS=
BEAN_INTEL_CROSSLINGUAL_TIMEOUT_MS=
BEAN_INTEL_GROUNDING_TIMEOUT_MS=
BEAN_INTEL_TECHDOCS_TIMEOUT_MS=
BEAN_VERIFY_MAX_ATTEMPTS=
BEAN_VERIFY_MAX_INPUT_CHARS=
BEAN_VERIFY_MIN_CONFIDENCE=
BEAN_VERIFY_MODEL=
BEAN_VERIFY_REGENERATIONS=
BEAN_VERIFY_TIMEOUT_MS=
JAZMII_VIDEO_DOWNLOAD_RETRY_MS=
JAZMII_VIDEO_MAX_POLL_MS=
JAZMII_VIDEO_POLL_INTERVAL_MS=
RIISHE_MAX_OUTPUT_TOKENS=
BEAN_LOG_LEVEL=
BEAN_ALLOW_LOCAL_PROVIDER_ENDPOINTS=
