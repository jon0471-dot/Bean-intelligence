// BEAN Intelligence — data model
// Customer identity, sessions, conversations, generation jobs,
// usage metering and administrative audit records.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String         @id @default(cuid())
  email               String         @unique
  passwordHash        String
  name                String?
  role                String         @default("member") // member | admin
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  sessions            Session[]
  conversations       Conversation[]
  jobs                GenerationJob[]
  usageRecords        UsageRecord[]
  documents           Document[]
  codeProjects        CodeProject[]
  imageAssets         ImageAsset[]
  memories            RiisheMemory[]
  providerCredentials ProviderCredential[]
  apiKeys             ApiKey[]
  laxiiConversations  LaxiiConversation[]
  jazmiiConversations JazmiiConversation[]
  jazmiiProductions   JazmiiProduction[]
  projects            Project[]
  clientComputeReports ClientComputeReport[]
  laxiiEditHistory     LaxiiEditHistory[]
  trustTasks          TrustTask[]
  narrationProjects   NarrationProject[]
  gangziiAudioAssets  GangziiAudioAsset[]
  missions            AgentMission[]
  evidenceKnowledge   EvidenceKnowledge[]
  autobots            AutobotAgent[]
  autobotTeams        AutobotTeam[]
  // M50.3 — BEAN AI STUDIO workflow persistence (additive).
  workflowDefinitions WorkflowDefinition[]
  workflowRuns        WorkflowRun[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  title     String    @default("New conversation")
  // Long-conversation context management: cached digest of the turns that
  // fell out of the model's history window. Regenerated only when the
  // overflow grows; deleted with the conversation (cascade).
  summary       String?
  summaryCount  Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  documents Document[]

  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String // user | assistant
  content        String
  tokensEstIn    Int?
  tokensEstOut   Int?
  latencyMs      Int?
  // RIISHE orchestration artifact for assistant messages: evidence sources,
  // response states (assigned from ACTUAL tool execution, never by the model)
  // and the verification summary. Null for plain messages.
  metadata       Json?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Document {
  id             String       @id @default(cuid())
  userId         String
  conversationId String?
  name           String // original filename (display only; never used for filesystem access)
  mime           String
  size           Int // uploaded bytes
  text           String // extracted text actually used as evidence (may be truncated)
  truncated      Boolean      @default(false)
  kind           String       @default("text") // detected capability: text|pdf|docx|data|image|audio|video|archive|code|binary
  status         String       @default("ready") // ready | unsupported | failed
  note           String? // honest processing explanation (why unsupported / what was extracted)
  metaJson       String? // capability-specific metadata (ffprobe fields, vision model note, archive summary)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model GenerationJob {
  id           String    @id @default(cuid())
  userId       String
  product      String // riishe | laxii | jazmii | code-giftz
  task         String // image-generation | video-generation | coding-task
  status       String // queued | running | completed | failed | rejected | unsupported
  progress     Int       @default(0)
  paramsJson   String // validated request parameters
  resultJson   String? // normalized result payload (artifact paths, metrics)
  errorCode    String?
  errorMessage String? // safe, customer-displayable message
  backendId    String? // private backend id — NEVER exposed to non-admin clients
  queuedAt     DateTime  @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ---------------------------------------------------------------------
  // BACKGROUND AI ENGINE (2026-11-07) — ADDITIVE durable-queue fields.
  // Existing columns/values are untouched; product routes keep their wire
  // contracts (extended states are normalized to the legacy vocabulary at
  // those boundaries). These fields give every job: an owning worker with a
  // time-limited claim (lease) that another worker can take over after a
  // crash, bounded retry scheduling, a duplicate-submission guard, an
  // honest error classification and a cooperative cancel flag.
  // ---------------------------------------------------------------------
  capability      String? // engine capability key (chat | text-to-image | image-editing | ...)
  workerId        String? // claiming worker instance id
  workerKind      String? // embedded (in-server) | standalone (worker process)
  leaseUntil      DateTime? // claim expiry — a stale lease means the worker died
  heartbeatAt     DateTime? // last worker liveness signal
  attempts        Int       @default(0)
  maxAttempts     Int       @default(2)
  nextRunAt       DateTime? // RETRY_WAIT scheduling (null = immediately eligible)
  errorClass      String? // rate_limited | auth | billing | timeout | network | worker_lost | permanent | cancelled | budget | none
  dedupeKey       String? // hash of user+product+task+params while a job is active
  cancelRequested Boolean   @default(false) // cooperative cancel for running jobs

  events JobEvent[]

  @@index([userId, product])
  @@index([status])
  @@index([product, status, nextRunAt])
  @@index([dedupeKey])
  @@index([leaseUntil])
}

/**
 * BACKGROUND AI ENGINE (2026-11-07) — additive append-only event log per job.
 * Workers stream partial text (chat/coding), progress, stages and research/
 * tool notices here; the SSE job-events endpoint replays them from any
 * cursor, so a client can disconnect and reattach (or never connect at all —
 * results persist regardless of who is watching).
 */
model JobEvent {
  id        String        @id @default(cuid())
  jobId     String
  seq       Int // per-job monotonic sequence
  type      String // delta | stage | progress | research | tool | reset | notice | error | artifact
  dataJson  String
  createdAt DateTime      @default(now())
  job       GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, seq])
  @@index([jobId, seq])
}

// LAXII preservation engine (2026-10-31): uploaded reference images,
// originals to enhance/edit, brush masks and produced artifacts.
// Additive table — existing models are untouched.
model ImageAsset {
  id        String   @id @default(cuid())
  userId    String
  kind      String // reference | original | mask | result
  mime      String
  width     Int?
  height    Int?
  bytes     Int
  path      String   @default("") // storage-relative path (ext from metaJson)
  metaJson  String?  // ext, provenance, pipeline metadata
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

model UsageRecord {
  id         String   @id @default(cuid())
  userId     String
  product    String
  backendId  String?
  kind       String // chat | image-generation | video-generation | coding-task
  tokensIn   Int? // estimated when provider does not report exact counts
  tokensOut  Int?
  imageCount Int?
  durationMs Int?
  costMicros Int? // null = cost data not reported by provider (never invented)
  success    Boolean  @default(true)
  errorCode  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, product])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String? // user performing the action, if authenticated
  action    String // e.g. auth.login, admin.view_backends, job.cancel
  target    String? // resource affected
  metaJson  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model CodeProject {
  id        String        @id @default(cuid())
  userId    String
  title     String
  // ---------------------------------------------------------------------
  // M22 (2026-11-15) — ADDITIVE project-persistence metadata. Existing
  // columns/values untouched; every new column is nullable or defaulted so
  // `prisma db push` is a non-destructive ALTER for existing rows.
  // ---------------------------------------------------------------------
  description   String? // user-edited project description (display only)
  framework     String? // detected/declared framework, e.g. 'react', 'vanilla' (display + export metadata)
  language      String? // primary language, e.g. 'javascript', 'typescript', 'python'
  status        String  @default("active") // active | archived (archived projects stay openable, excluded from default lists)
  lastOpenedAt  DateTime? // set when the owner opens the project (recency metadata)
  currentVersion Int    @default(0) // seq of the latest persisted version; 0 = no files/snapshots yet
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  CodeMessage[]
  files     CodeFile[]
  blobs     CodeBlob[]
  versions  CodeVersion[]
  fileOperations CodeFileOperation[]

  @@index([userId, updatedAt])
  @@index([userId, status, updatedAt])
}

// ----------------------------------------------------------------------
// M22 PROJECT VERSIONING (2026-11-15) — storage-efficient snapshots.
//
// Files are stored once per unique content: CodeBlob rows are deduped by
// SHA-256 per project, and a CodeVersion maps paths -> blob hashes. A
// rollback creates a NEW version referencing the old file set (history is
// never rewritten or deleted). Integrity: contentHash covers the sorted
// (path, blobHash) pairs so partial/corrupt snapshots are detectable.
// ----------------------------------------------------------------------
model CodeBlob {
  id        String      @id @default(cuid())
  projectId String
  hash      String // sha-256 hex of content (per-project dedup key)
  content   String
  size      Int
  createdAt DateTime    @default(now())
  project   CodeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, hash])
  @@index([projectId])
}

model CodeVersion {
  id               String      @id @default(cuid())
  projectId        String
  seq              Int // 1-based, monotonic per project
  kind             String // initial | turn | manual | rollback | file-save | file-delete
  summary          String? // short human-readable change summary (what happened, honestly)
  changedFilesJson String? // JSON [{path, change, added, removed}] vs the previous version (seq 1 lists every file as added — a diff from nothing)
  contentHash      String // integrity hash over the sorted (path, blobHash) pairs
  fileCount        Int
  createdAt        DateTime    @default(now())
  project          CodeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  files            CodeVersionFile[]

  @@unique([projectId, seq])
  @@index([projectId, createdAt])
}

model CodeVersionFile {
  id           String      @id @default(cuid())
  versionId    String
  path         String
  blobHash     String? // sha-256 of this file's content in THIS version; null never occurs here (deletions are absences)
  change       String      @default("added") // change vs the PREVIOUS version: added | modified | renamed
  previousPath String? // set for renamed entries (same blobHash, different path)
  version      CodeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, path])
  @@index([versionId])
}

model CodeMessage {
  id        String      @id @default(cuid())
  projectId String
  role      String // user | assistant
  content   String
  metaJson  String? // file changes summary (added/modified/diffs) for honest UI history
  createdAt DateTime    @default(now())
  project   CodeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model CodeFile {
  id        String      @id @default(cuid())
  projectId String
  path      String
  content   String
  origin    String      @default("generated") // generated | modified
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  project   CodeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
  @@index([projectId])
}

// ---------------------------------------------------------------------------
// M23 (2026-11-15) — ADDITIVE file-operation ledger. One row per structured
// operation plan (rename/move/delete/create/batch/repair). Carries the exact
// plan (planJson) and its integrity hash (planHash) so a confirmation is
// bound to the plan the user saw; the status lifecycle (awaiting_confirmation
// → executed | cancelled | failed | stale) makes execution replay-safe.
// Cascades with the project; no existing table or column is touched.
// ---------------------------------------------------------------------------
model CodeFileOperation {
  id         String      @id @default(cuid())
  projectId  String
  kind       String // rename | move | delete | create | batch-move | batch-rename | repair
  status     String      @default("awaiting_confirmation") // awaiting_confirmation | executed | cancelled | failed | stale
  planJson   String // the exact structured plan the user was shown
  planHash   String // sha-256 over the canonical plan JSON — binds the confirmation
  resultJson String? // truthful execution result (recorded once, replayed verbatim)
  createdAt  DateTime    @default(now())
  executedAt DateTime?
  project    CodeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
}

// RIISHE user-approved memory (explicit facts the user asked RIISHE to keep;
// per-user isolated; deleted on request — see src/lib/riishe/memory.ts).
model RiisheMemory {
  id        String   @id @default(cuid())
  userId    String
  content   String // the fact, exactly as confirmed to the user
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// M43 evidence-linked knowledge (Phase 6): claim-level knowledge with full
// provenance, temporal validity, version chains and per-user isolation.
// Stored ONLY with its sources and verification status — an unverified
// research note can never be stored under a trusted class (enforced in
// src/lib/riishe/evidence-memory.ts). No duplicate vector store: retrieval
// is deterministic over the bounded rows; embeddings stay optional on the
// existing MiniLM lane.
model EvidenceKnowledge {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId           String?   // set when the knowledge is project-scoped
  domain              String    // M43 KnowledgeDomain
  knowledgeClass      String    // permanent-foundational | version-sensitive | time-sensitive | project-specific | user-authorized | unverified-research-note
  claim               String    // the knowledge statement, bounded at write time
  verificationOutcome String?   // M43 ClaimOutcome when verified; null for unverified notes
  confidence          String    // high | medium | low
  sourcesJson         String    // EvidenceAttributionView[] (bounded attribution, preserved through handoffs)
  independenceGroups  Int       // distinct corroborating source groups at write time (copies never inflate)
  freshnessStatus     String    // fresh | aging | expired | unknown (at write time)
  claimKey            String    // canonical claim key for dedupe (normalized)
  validFrom           DateTime? // temporal validity start (claim-effective date when known)
  validUntil          DateTime? // temporal validity end (freshness expiry)
  supersedesId        String?   // version chain: the record this one supersedes (history preserved)
  retractedAt         DateTime? // retraction/correction: the row is retained, never silently deleted
  retractionNote      String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([userId, domain, knowledgeClass])
  @@index([userId, createdAt])
  @@index([claimKey])
  @@index([supersedesId])
}

// ---- Unified AI gateway (2026-11-04 work order) -----------------------------
// Additive tables only — existing models are untouched. All secret material
// is stored encrypted (AES-256-GCM) or hashed (SHA-256); raw secrets are
// NEVER persisted and NEVER returned by any API response.

// External PROVIDER credentials (secret type A): the admin-supplied API keys
// that let the gateway call third-party inference providers. Encrypted at
// rest with the master key from the environment; never sent to any client.
model ProviderCredential {
  id          String    @id @default(cuid())
  provider    String // registered provider id, e.g. 'openai-compatible'
  label       String // admin-chosen display label
  // AES-256-GCM payload (versioned envelope). Contains the provider API key
  // and optional endpoint overrides as JSON — readable ONLY server-side with
  // the master key, which lives outside this database.
  encrypted   String
  // Masked, display-only hint (e.g. "sk-…ab12") — no usable secret material.
  maskedHint  String
  status      String    @default("active") // active | revoked
  keyVersion  Int       @default(1) // master-key envelope version
  baseUrl     String? // endpoint override (non-secret), used by the adapter
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastUsedAt  DateTime?
  user        User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([provider, status])
}

// DEVELOPER PORTAL PROJECTS (Phase 1, 2026-11-13) — additive tenancy model.
// Single-owner: each Project belongs to exactly one user. Organizations,
// teams and shared ownership are deliberately deferred (Phase 1 scope).
model Project {
  id        String   @id @default(cuid())
  userId    String // owning user (single-owner tenancy)
  name      String
  status    String   @default("active") // active | archived
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeys   ApiKey[]

  @@index([userId, updatedAt])
  @@index([userId, status])
}

// CODE GIFTZ APPLICATION API keys (secret type B): gateway access tokens for
// BEAN products and third-party integrations. Only a SHA-256 hash is stored;
// the complete key is shown exactly once at creation.
model ApiKey {
  id              String    @id @default(cuid())
  userId          String // owning administrator (usage attribution)
  name            String
  prefix          String // first chars (e.g. "bgk_abcd") — lookup + masked display
  keyHash         String    @unique // SHA-256 hex of the FULL key; raw key never stored
  permissions     String    @default("[]") // JSON array of granted scopes
  rateLimitPerMin Int       @default(60)
  status          String    @default("active") // active | revoked
  expiresAt       DateTime?
  lastUsedAt      DateTime?
  requestCount    Int       @default(0)
  createdAt       DateTime  @default(now())
  revokedAt       DateTime?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // PHASE 1 (2026-11-13) — ADDITIVE project scoping. NULL = legacy
  // administrator key with unchanged platform-wide behavior; a non-null
  // projectId binds the key to that single Project (its grants can never
  // reach another project's resources). Cascade: deleting a project removes
  // its keys — a project key must never silently widen into a legacy key.
  projectId       String?
  project         Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([keyHash])
  @@index([userId, status])
  @@index([projectId])
}

// Per-request gateway diagnostics (admin-facing; no prompts, no secrets).
// Usage aggregates for metering live in UsageRecord (product 'api-gateway').
model GatewayRequestLog {
  id         String   @id @default(cuid())
  authKind   String // session | api-key
  keyId      String? // application API key id (when api-key auth)
  userId     String? // owning user of the session or key
  provider   String
  model      String
  endpoint   String
  status     Int // HTTP status returned
  errorCode  String?
  tokensIn   Int?
  tokensOut  Int?
  durationMs Int?
  streamed   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([keyId])
}

// Runtime-tunable operator settings (self-verification controls, etc.).
// JSON-string values; admins update via /api/admin/verification.
model SystemSetting {
  key       String   @id
  value     String
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// LAXII UNIFIED CONVERSATIONAL STUDIO (2026-11-12) — additive persistence for
// the one-workspace redesign. Existing GenerationJob and ImageAsset records
// are the source of truth for every artifact and job state; these tables only
// LINK to them by id (jobId / assetId), so all artifact references and
// storage paths keep working and no existing row is rewritten.
model LaxiiConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New image conversation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  LaxiiMessage[]

  @@index([userId, updatedAt])
}

model LaxiiMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String // user | assistant
  kind           String // text | job | clarify | mask-request
  text           String?
  // Optional LINKS — never copies: the referenced GenerationJob / ImageAsset
  // rows stay owned by their existing pipelines.
  assetId        String?
  jobId          String?
  maskAssetIds   String? // JSON array of mask asset ids (masked-edit flow)
  metaJson       String? // intent, engine hints, capability truth
  createdAt      DateTime @default(now())
  conversation   LaxiiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// JAZMII CONVERSATIONAL VIDEO STUDIO (2026-11-12) — additive persistence for
// the one-workspace redesign. Existing GenerationJob rows remain the source
// of truth for every video artifact and job state; these tables only LINK to
// them by id (jobId), so artifact references (/api/jazmii/jobs/<id>/media),
// provider recovery and retry logic keep working untouched.
model JazmiiConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New video conversation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  JazmiiMessage[]

  @@index([userId, updatedAt])
}

model JazmiiMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String // user | assistant
  kind           String // text | job
  text           String?
  // Optional LINK to the GenerationJob that executes (or executed) this turn.
  jobId          String?
  // Generation settings chosen in the composer for this turn (size,
  // durationSec, quality, withAudio, hasReferenceImage) — display data only;
  // the authoritative copy lives in GenerationJob.paramsJson.
  metaJson       String?
  createdAt      DateTime @default(now())
  conversation   JazmiiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ---------------------------------------------------------------------------
// JAZMII AUTO DIRECTOR (2026-11-20) — additive story-to-finished-video
// production models. A JazmiiProduction is one creative project: a
// schema-validated storyboard (the creative contract), per-scene generation
// state, and the composed deliverables. Scene GENERATION still lives in
// GenerationJob rows (task 'video-generation') — every scene row only LINKS
// to its job by id, so provider recovery, cancellation, receipts and media
// serving keep working untouched. Additive only: no existing model changes.
// ---------------------------------------------------------------------------
model JazmiiProduction {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String    @default("Untitled production")
  // draft | awaiting_approval | generating | composing | rendering | validating
  // | completed | completed_with_limitations | partially_completed | failed | cancelled
  status         String    @default("draft")
  // The ORIGINAL validated planner proposal (awaiting approval) — display
  // only; the authoritative generation contract is storyboardJson below.
  briefJson      String?
  // The APPROVED plan (ApprovedPlan: storyboard + engine preference + audio).
  storyboardJson String?
  storyboardRev  Int       @default(0)
  style          String? // creative mode (display)
  aspect         String    @default("9:16")
  width          Int       @default(1080)
  height         Int       @default(1920)
  fps            Int       @default(30)
  requestedDurationSec Int?
  // Composition engine ACTUALLY used ('ffmpeg' | 'hyperframes') — recorded
  // after composition, never assumed.
  engine         String?
  progress       Int       @default(0)
  cancelRequested Boolean  @default(false)
  approvedAt     DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  errorClass     String?
  errorCode      String?
  errorMessage   String? // safe, customer-displayable
  // Final deliverables manifest (storage-relative paths + measured facts).
  deliverableJson String?
  // LINK to the orchestration GenerationJob (task 'video-production').
  jobId          String?
  // LINK to the Trust Engine task carrying this production's receipt.
  trustTaskId    String?
  scenes         JazmiiScene[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, updatedAt])
  @@index([userId, status])
}

// One storyboard scene = one video-generation GenerationJob + its media.
// Asset paths are STORAGE-RELATIVE (raw/ keeps the provider output verbatim —
// never overwritten; clips/ holds the normalized composition input).
model JazmiiScene {
  id            String   @id @default(cuid())
  productionId  String
  production    JazmiiProduction @relation(fields: [productionId], references: [id], onDelete: Cascade)
  idx           Int // 1-based timeline order
  sceneJson     String // the scene spec copied from the approved storyboard
  // pending | generating | ready | failed
  status        String   @default("pending")
  // LINK to the scene's GenerationJob (video-generation). One scene row per
  // generation attempt slot — a regeneration creates a NEW job id here.
  jobId         String?
  rawAssetPath  String?
  assetPath     String?
  probeJson     String? // ffprobe facts of assetPath
  attempts      Int      @default(0)
  errorClass    String?
  errorMessage  String?
  updatedAt     DateTime @updatedAt

  @@unique([productionId, idx])
  @@index([productionId, status])
}

// CLIENT COMPUTE (2026-11-16) — additive, sanitized capability-report
// persistence for the shared client-first hybrid compute engine. Rows carry
// ONLY the sanitized report (booleans, coarse numbers, tier) defined by
// src/lib/client-compute/telemetry.ts — never vendor/architecture strings,
// user agents, task payloads or prompt text. Reports are per-user evidence
// for the existing health/diagnostics systems; a client can never
// self-attest completion of server-authoritative work.
model ClientComputeReport {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier        Int
  conservative Boolean
  // Full sanitized CapabilityReport (JSON, bounded shape — validated by the
  // route's zod schema before storage).
  reportJson  String
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

// LAXII EDIT HISTORY (M26.2, 2026-11-18) — append-only lineage of REAL
// completed edit jobs so every edit is undoable/restoreable. One row per
// completed edit: the asset the edit started from (baseAssetId), the
// produced asset (resultAssetId), the engine that executed it and the
// executed op plan. Undo/restore are THEMSELVES new rows (append-only),
// cloning the base pixels into a fresh result asset — no row is ever
// rewritten, so history stays a truthful record.
model LaxiiEditHistory {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  baseAssetId   String
  resultAssetId String
  jobId         String?
  // local-edit | hosted-edit | lama-object-removal | restore | hosted-bg-removal | local-bg-removal
  engine        String
  mode          String
  // Executed op plan (JSON) — display data; provenance detail lives in the job row.
  opsJson       String
  approval      Boolean   @default(false)
  undoneAt      DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId, baseAssetId, createdAt])
  @@index([userId, resultAssetId])
}
// ---------------------------------------------------------------------------
// TRUST ENGINE (2026-11-20) — ADDITIVE execution-evidence foundation.
//
// One TrustTask row per meaningful agent task; its steps, evidence, approvals
// and checkpoints are append-only child tables. The composition of those rows
// IS the inspectable execution receipt (src/lib/trust/receipt.ts) — nothing
// is copied or rewritten, so a receipt always reflects the real ledger.
//
// Lifecycle contract (src/lib/trust/types.ts):
//   planned → running → waiting_for_approval → running → terminal
// A task may ONLY reach a terminal state through finalizeTrustTask /
// failTrustTask / cancelTrustTask, and a "completed" outcome REQUIRES a
// non-empty verification summary — a task is never marked completed merely
// because a model returned text.
//
// Secrecy contract: trust rows must never contain secrets, tokens or key
// material; callers store bounded structured detail only. All rows cascade
// with the owning user. No existing table or column is touched.
// ---------------------------------------------------------------------------
model TrustTask {
  id             String    @id @default(cuid())
  userId         String
  product        String // riishe | laxii | jazmii | code-giftz
  kind           String // chat | research | document-intel | coding-task | image-generation | video-generation
  title          String // short customer-displayable task title
  // The user's request, bounded for receipt inspection (owner's own data).
  requestPreview String?
  requestChars   Int? // original request length — size marker without storing more text
  status         String    @default("planned") // planned | waiting_for_approval | running | completed | completed_with_limitations | partially_completed | failed | cancelled
  outcomeSummary String? // what actually happened, stated honestly
  // Non-empty for every completed* / partially_completed outcome — the
  // verification result appropriate to this task (never a bare model reply).
  verificationSummary String?
  limitationsJson     String? // JSON array of honest limitation statements
  failureNote    String? // truthful failure/cancel reason for failed | cancelled
  // Links — never copies: the referenced rows stay owned by their pipelines.
  jobId          String? // GenerationJob when executed on the durable queue
  conversationId String?
  projectId      String?
  startedAt      DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps          TrustStep[]
  evidence       TrustEvidence[]
  approvals      TrustApproval[]
  checkpoints    TrustCheckpoint[]

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([jobId])
}

// Planned vs actually-attempted steps. Append-only ledger: statuses advance
// (planned → running → done | failed | skipped); rows are never deleted.
model TrustStep {
  id         String    @id @default(cuid())
  taskId     String
  seq        Int // per-task monotonic
  kind       String // plan | retrieval | tool | generation | verification | delivery | approval | recovery
  title      String
  detailJson String? // bounded structured detail (tool names, query counts) — never secrets
  status     String    @default("planned") // planned | running | done | failed | skipped
  errorNote  String? // honest failure description when status = failed
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  task       TrustTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, seq])
  @@index([taskId])
}

// Evidence ledger: provenance for claims and outputs. `origin` separates
// extracted information (real sources, real tool outputs) from model
// interpretation — receipts must never blur that line.
model TrustEvidence {
  id        String    @id @default(cuid())
  taskId    String
  stepSeq   Int?
  kind      String // source | document | tool-output | artifact | measurement | limitation
  ref       String // provenance reference: URL, document id, tool/artifact name
  title     String?
  locator   String? // page/section/line reference when available
  digest    String? // sha-256 of the referenced bytes when available
  origin    String    @default("extracted") // extracted | model_interpretation
  note      String? // bounded provenance note (retrieval channel, engine)
  createdAt DateTime  @default(now())
  task      TrustTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// Scoped approval ledger (mirrors the CodeFileOperation planHash pattern):
// the sha-256 actionDigest binds the decision to the EXACT proposed action.
// Scope is always single-action — an approval is consumed on use and never
// carries over to other actions.
model TrustApproval {
  id           String    @id @default(cuid())
  taskId       String
  actionDigest String // sha-256 over the canonical proposed action JSON
  actionJson   String // the exact proposed action shown to the user
  summary      String // customer-displayable description of the action
  scope        String    @default("single") // single (consumed on use)
  status       String    @default("requested") // requested | granted | denied | consumed | expired | cancelled
  requestedAt  DateTime  @default(now())
  decidedAt    DateTime?
  expiresAt    DateTime?
  consumedAt   DateTime?
  task         TrustTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, status])
  @@index([actionDigest])
}

// Safe checkpoints for long-running tasks: append-only; the newest valid row
// is the resume point. Payloads hold only safe resumable state — never
// credentials, tokens or prompt text.
model TrustCheckpoint {
  id          String    @id @default(cuid())
  taskId      String
  seq         Int // per-task monotonic
  label       String
  status      String    @default("valid") // valid | superseded
  payloadJson String?
  createdAt   DateTime  @default(now())
  task        TrustTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, seq])
  @@index([taskId, status])
}

// ---------------------------------------------------------------------------
// GANGZII NARRATION STUDIO (M27, 2026-11-21).
//
// One NarrationProject per narration script; segments are the user-editable
// units (a sentence change regenerates ONE segment, never the whole track).
// The original visible script is preserved separately from the normalized
// synthesis text — normalization never silently changes the user's wording.
// Segment timing is MEASURED from the produced audio (segment-level,
// approximate — never word-level alignment, which no installed engine
// provides). JAZMII linkage records WHERE a narration came from without
// coupling GANGZII storage to JAZMII internals.
// ---------------------------------------------------------------------------
model NarrationProject {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title              String   @default("Untitled narration")
  language           String   @default("en")
  // manual | jazmii-storyboard — the honest provenance of the script.
  source             String   @default("manual")
  // JAZMII production this narration is attached to (optional; no FK on
  // purpose: GANGZII narration must survive JAZMII production deletion).
  jazmiiProductionId String?
  // Associations: [{ sceneIdx, segmentIdx, caption }] — scene-aligned timing.
  sceneAssociationsJson String?
  // original | approved — the approved flag gates the join/export actions.
  status             String   @default("draft") // draft | approved | joined
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  segments           NarrationSegment[]

  @@index([userId, updatedAt])
  @@index([jazmiiProductionId])
}

model NarrationSegment {
  id                 String   @id @default(cuid())
  projectId          String
  project            NarrationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  idx                Int      // 1-based deterministic order
  // The user's OWN text (never rewritten) and the normalized synthesis text.
  text               String
  normalizedText     String
  voice              String   // voice id from either engine catalog
  speed              Float    @default(1.0)
  // pending | generating | ready | failed — ready requires a real artifact.
  status             String   @default("pending")
  generationJobId    String?  // the speech-synthesis job for THIS segment
  artifactRelPath    String?  // storage-relative master segment audio
  durationMs         Int?     // MEASURED (ffprobe) after synthesis
  errorNote          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([projectId, idx])
  @@index([projectId, status])
}

// GANGZII AUDIO LIBRARY (M27): user-uploaded / user-provided audio assets
// with license + attribution metadata. BEAN bundles NO third-party media —
// every library asset is either user-uploaded or BEAN-owned with verified
// licensing, recorded here per asset.
model GangziiAudioAsset {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName    String
  relPath        String   // storage-relative under storage/gangzii/<userId>/assets
  kind           String   @default("music") // music | sfx | voiceover-upload
  container      String   // magic-byte verified container
  bytes          Int
  durationMs     Int?
  // Rights metadata (user-provided, shown in receipts and UI).
  license        String?  // e.g. "CC-BY 4.0", "Owned", "Licensed — <source>"
  attribution    String?
  sourceUrl      String?
  createdAt      DateTime @default(now())

  @@index([userId, kind])
}

// ---------------------------------------------------------------------------
// M41 — AUTONOMOUS MULTI-AGENT MISSIONS (2026-11-26)
// ---------------------------------------------------------------------------
// One AgentMission per planned multi-part objective; its specialist tasks are
// AgentMissionTask rows with explicit dependencies, authorization scopes,
// verification criteria and bounded resource limits. Execution runs on the
// EXISTING durable engine (a GenerationJob with product 'riishe' and task
// 'mission-run' claims + heartbeats + lease recovery), specialist work runs
// through the EXISTING delegation paths (coding jobs + media jobs with their
// own preflight/dedupe/quota gates), provenance lives in the EXISTING Trust
// Engine. No second queue, no second ledger. No secrets in any field; every
// free-text field is size-bounded at write time.

model AgentMission {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionType       String // website-build | media-production | research-document | debug-app
  objective         String // the user's objective, bounded at submit time
  deliverableTaskId String // mission success stands on this task
  status            String // planned | running | completed | completed_partial | failed | cancelled
  planJson          String // the planned task specs (bounded)
  detectedJson      String? // customer-safe detection summary (JSON array)
  trustTaskId       String? // the Trust Engine provenance task for this mission
  jobId             String? // the mission-run GenerationJob driving execution
  cancelRequested   Boolean  @default(false)
  failureNote       String? // truthful reason for failed/cancelled missions
  outcomeSummary    String? // bounded customer-safe delivery summary
  // M49.2 (additive, nullable): the Autobot team that ran this mission. Null
  // for individual/RIISHE-chat missions. SetNull on team deletion — the
  // mission's immutable teamSnapshotJson below preserves the execution
  // context even after the team row is gone.
  teamId            String?
  team              AutobotTeam? @relation(fields: [teamId], references: [id], onDelete: SetNull)
  // M49.2 (additive, nullable): the IMMUTABLE team execution snapshot taken
  // at mission start (team identity, membership, agent identities, capability
  // keys, roles, bounded persona preferences, task assignments). Editing a
  // team or agent afterwards never changes a running mission's context.
  teamSnapshotJson  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  startedAt         DateTime?
  finishedAt        DateTime?
  tasks             AgentMissionTask[]

  @@index([userId, status])
  @@index([jobId])
  @@index([teamId])
}

model AgentMissionTask {
  id                     String   @id @default(cuid())
  missionId              String
  mission                AgentMission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  taskId                 String // stable in-plan id ('build', 'verify', …)
  kind                   String // fixed M41 task kind vocabulary
  agent                  String // fixed kind→agent routing (audit copy)
  title                  String // short customer-safe title
  objective              String // enriched at execution time (handoffs), bounded
  paramsJson             String // validated task params
  expectedOutput         String // the verifier's contract
  dependsOnJson          String // JSON array of taskIds
  authScope              String // fixed kind→scope routing (audit copy)
  verificationJson       String // criteria JSON
  limitsJson             String // bounded resource limits
  status                 String // pending | ready | running | done | failed | skipped | cancelled
  attempts               Int      @default(0)
  corrections            Int      @default(0)
  specialistJobId        String? // the delegated durable GenerationJob (media/coding)
  executionJson          String? // bounded REAL execution payload digest
  verificationResultJson String? // {status, reasons[], artifacts[]} from the deterministic verifier
  failureNote            String?
  artifactJson           String? // admitted artifacts (JSON array)
  // M49.2 (additive, nullable): the assigned Autobot team member snapshot for
  // this task (memberId, agentId, agentName, capabilityKey, bounded persona
  // preferences). Written ONCE at mission creation from the server-side
  // assignment engine; never mutated afterwards (execution snapshot rule).
  assignmentJson         String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([missionId, taskId])
  @@index([missionId, status])
  @@index([specialistJobId])
}

// M45 — per-turn conversational execution decisions. One row per decision
// created from a RIISHE conversation turn; the decision JSON carries the
// full M44 outcome (rationale, confidence trail, alternative matrix) and the
// plan JSON the digest-bound approval belongs to. Owner-scoped reads only.
model ExecutionDecision {
  id                String   @id @default(cuid())
  userId            String
  conversationId    String
  turnId            String // the turn that created the decision
  objective         String // bounded conversational objective
  status            String   @default("created") // created | planned | awaiting-approval | executing | succeeded | partially-succeeded | failed | blocked | cancelled | recovery-required
  decisionKind      String // decided | insufficient-evidence | escalated
  decisionJson      String // bounded full M44 DecisionOutcome
  planDigest        String? // the ActionPlan digest when a plan exists
  planJson          String? // bounded ActionPlan (contracts + digest)
  recordsJson       String? // bounded execution records after a run
  trustTaskId       String? // the Trust ledger task for this decision
  bindingDigest     String // canonical digest over (user, conversation, turn, mission)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId, conversationId])
  @@index([userId, status])
  @@index([trustTaskId])
}

// ---------------------------------------------------------------------------
// M49.1 — BEAN AUTOBOTS: the user-facing AI workforce.
//
// An AutobotAgent is a PERSONA the user configures (identity, profession,
// instructions, capability selection, memory mode). It is NOT an execution
// worker: every turn rides the EXISTING RIISHE orchestration through the
// `riishe` chat product, and every delegated specialist action rides the
// EXISTING durable job queue. The agent's `capabilityKey` — server
// vocabulary, never persona text — decides which tool-permission keys a turn
// runs with. Persona/instructions are USER-CONFIGURABLE DATA, framed as
// untrusted preferences at execution time; they can never widen tool access.
// ---------------------------------------------------------------------------
model AutobotAgent {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String // bounded display name (1-60)
  role           String // profession / role label (bounded 60)
  industry       String?  // bounded free text (80)
  description    String // what this agent does, user-facing (bounded 1000)
  personality    String?  // communication style preferences (bounded 1000)
  instructions   String?  // working preferences — UNTRUSTED user data (bounded 4000)
  language       String?  // language preference (bounded 60)
  // The REAL execution capability (fixed vocabulary: advisory | research |
  // engineering | visual | motion | voice | review). Server-authoritative:
  // the ONLY input to per-turn tool-permission derivation.
  capabilityKey  String
  // Permitted memory mode: 'disabled' (fresh each session) or 'conversation'
  // (this workspace history is retained). Agent-level long-term memory is
  // NOT implemented in M49.1 (planned — see docs/ai/systems/AUTOBOTS.md).
  memoryMode     String   @default("disabled")
  // Catalogue template this agent was created from (null = fully custom).
  templateKey    String?
  status         String   @default("active") // active | archived
  executionCount Int      @default(0) // real completed turns (honest usage signal)
  lastExecutedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  conversations  AutobotConversation[]
  teamMemberships AutobotTeamMember[]

  @@index([userId, status])
  @@index([userId, createdAt])
}

// An agent workspace conversation. Distinct from the RIISHE Conversation
// model on purpose: agent transcripts are scoped to the agent persona, so a
// RIISHE assistant conversation and an Autobot workspace never mix context.
model AutobotConversation {
  id        String        @id @default(cuid())
  agentId   String
  agent     AutobotAgent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  // Denormalized owner scope (audit + owner-indexed cleanup); always the
  // agent's owner — enforced at every API touchpoint.
  userId    String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  AutobotMessage[]

  @@index([agentId])
  @@index([userId])
}

model AutobotMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   AutobotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user | assistant
  content        String
  // RIISHE orchestration artifact (sources, response states, verification
  // summary) — the same honest metadata contract as Message.metadata. Null
  // for plain rows.
  metadata       Json?
  latencyMs      Int?
  tokensEstIn    Int?
  tokensEstOut   Int?
  createdAt      DateTime            @default(now())

  @@index([conversationId])
}

// ---------------------------------------------------------------------------
// M49.2 — BEAN AUTOBOT TEAMS: a user-configured COMPOSITION of their own
// Autobot agents. A team is coordination metadata for the EXISTING M41
// mission machinery — never a second execution framework, never an
// agent-to-agent chat fabric. The member's `capabilityKey` (fixed M49.1
// vocabulary, server-authoritative) is the ONLY thing that decides which
// M41 task kinds a member can be assigned; names, responsibility text and
// instructions are descriptive user data and can never widen authorization.
// The team leader is attribution/coordination copy — never extra permission.
// ---------------------------------------------------------------------------
model AutobotTeam {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String // bounded display name (1-80)
  description        String   @default("") // bounded free text (600)
  // The coordinating member (a AutobotTeamMember id in THIS team). Copy for
  // coordination/attribution only — being the leader grants NO extra tools.
  leaderMemberId     String?
  // Descriptive workflow preference from the fixed vocabulary ('auto' |
  // 'research-first' | 'build-first' | 'review-heavy'). It never alters the
  // deterministic M41 planner, the DAG kernel or any authorization scope.
  workflowPreference String   @default("auto")
  // The deterministic multi-member assignment rule ('team-order' |
  // 'leader-first'). A pure ordering over the SAVED roster — it never
  // consults persona text and never widens authorization.
  assignmentPreference String  @default("team-order")
  templateKey        String? // catalogue team template (null = fully custom)
  status             String   @default("active") // active | archived
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  members            AutobotTeamMember[]
  missions           AgentMission[]

  @@index([userId, status])
  @@index([userId, createdAt])
}

// One agent inside one team, with a descriptive responsibility. The agent
// MUST belong to the same user as the team (enforced at every service
// touchpoint). Cascade on agent deletion — a team cannot reference an agent
// that no longer exists.
model AutobotTeamMember {
  id             String       @id @default(cuid())
  teamId         String
  team           AutobotTeam  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  agentId        String
  agent          AutobotAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  // Descriptive responsibility text (bounded 300) — USER DATA, never
  // authorization; the assignment engine reads ONLY the agent's capabilityKey.
  responsibility String       @default("")
  // Saved team order (deterministic tie-break for assignment).
  orderIndex     Int          @default(0)
  createdAt      DateTime     @default(now())

  @@unique([teamId, agentId])
  @@index([teamId, orderIndex])
}

// ---------------------------------------------------------------------------
// M50.3 — BEAN AI STUDIO workflow persistence (ADDITIVE; three tables only).
//
// Persistence for the M50.2 pure graph core. A WorkflowDefinition is the
// owner-scoped container; WorkflowVersion rows are its immutable-once-
// published graph snapshots (draft → published → superseded, monotonic
// (definitionId, version)); WorkflowRun is the THIN future execution-
// reference model created only when M50.5 actually runs a workflow — the
// real lifecycle authority stays the M41 AgentMission row.
//
// M50.3 deletion policy (the conservative resolution of M50.1 §8.1/§7.14):
//  - a definition with WorkflowRun rows cannot be archived-with-delete or
//    physically deleted; the SERVICE refuses with an honest 409 and offers
//    archiving (see src/lib/ai-studio/workflow-service.ts);
//  - with zero runs, deleting a definition cascades its (unused) versions;
//  - the AgentMission reference is a LOOSE unique string (missionId), the
//    app's existing cross-aggregate discipline (AgentMission.trustTaskId /
//    .jobId / AgentMissionTask.specialistJobId) — a hard FK here would put
//    a RESTRICT edge inside the user-cascade chain, where SQLite's
//    undefined multi-table cascade ordering can break account deletion;
//  - M50.3 NEVER deletes AgentMission / AgentMissionTask history.
// ---------------------------------------------------------------------------
model WorkflowDefinition {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String // bounded display name (1-80)
  description String   @default("") // bounded free text (600)
  status      String   @default("active") // active | archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  versions    WorkflowVersion[]
  runs        WorkflowRun[]

  @@index([userId, status])
  @@index([userId, createdAt])
}

// One saved graph snapshot of one definition. A DRAFT is freely editable;
// PUBLISH freezes it (publishedAt set, graph never mutated again);
// publishing a newer version marks the previous published one SUPERSEDED —
// still immutable. Version numbers are monotonic per definition; the
// (definitionId, version) uniqueness is the transaction-race backstop.
model WorkflowVersion {
  id           String             @id @default(cuid())
  definitionId String
  definition   WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  version      Int
  status       String             @default("draft") // draft | published | superseded
  graphJson    String // schema-validated graph JSON, bounded 65,536 chars
  changeNote   String             @default("") // bounded free text (300)
  publishedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  runs         WorkflowRun[]

  @@unique([definitionId, version])
  @@index([definitionId, status])
}

// The thin future execution-reference model (M50.5 creates rows; M50.3
// never does). compiledPlanJson carries the bounded compiled node→task
// mapping and deliverable metadata so a run can be traced to its exact
// immutable version without recompiling. missionId is the unique loose
// M41 AgentMission reference (see the deletion-policy note above); the
// mission row remains the ONLY execution lifecycle authority.
model WorkflowRun {
  id               String             @id @default(cuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  definitionId     String
  definition       WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  versionId        String
  version          WorkflowVersion    @relation(fields: [versionId], references: [id], onDelete: Cascade)
  missionId        String             @unique
  objective        String // bounded to the M41 objective limit (4,000)
  compiledPlanJson String // bounded compiled plan mapping/metadata
  status           String             @default("planned") // mirrors the real mission status
  failureNote      String?
  createdAt        DateTime           @default(now())
  finishedAt       DateTime?

  @@index([userId, status])
  @@index([definitionId])
  @@index([versionId])
}
