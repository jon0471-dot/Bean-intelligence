// BEAN Intelligence — data model
// Customer identity, sessions, conversations, generation jobs,
// usage metering and administrative audit records.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String         @id @default(cuid())
  email               String         @unique
  passwordHash        String
  name                String?
  role                String         @default("member") // member | admin
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  sessions            Session[]
  conversations       Conversation[]
  jobs                GenerationJob[]
  usageRecords        UsageRecord[]
  documents           Document[]
  codeProjects        CodeProject[]
  imageAssets         ImageAsset[]
  memories            RiisheMemory[]
  providerCredentials ProviderCredential[]
  apiKeys             ApiKey[]
  laxiiConversations  LaxiiConversation[]
  jazmiiConversations JazmiiConversation[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  title     String    @default("New conversation")
  // Long-conversation context management: cached digest of the turns that
  // fell out of the model's history window. Regenerated only when the
  // overflow grows; deleted with the conversation (cascade).
  summary       String?
  summaryCount  Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  documents Document[]

  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String // user | assistant
  content        String
  tokensEstIn    Int?
  tokensEstOut   Int?
  latencyMs      Int?
  // RIISHE orchestration artifact for assistant messages: evidence sources,
  // response states (assigned from ACTUAL tool execution, never by the model)
  // and the verification summary. Null for plain messages.
  metadata       Json?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Document {
  id             String       @id @default(cuid())
  userId         String
  conversationId String?
  name           String // original filename (display only; never used for filesystem access)
  mime           String
  size           Int // uploaded bytes
  text           String // extracted text actually used as evidence (may be truncated)
  truncated      Boolean      @default(false)
  kind           String       @default("text") // detected capability: text|pdf|docx|data|image|audio|video|archive|code|binary
  status         String       @default("ready") // ready | unsupported | failed
  note           String? // honest processing explanation (why unsupported / what was extracted)
  metaJson       String? // capability-specific metadata (ffprobe fields, vision model note, archive summary)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model GenerationJob {
  id           String    @id @default(cuid())
  userId       String
  product      String // riishe | laxii | jazmii | code-giftz
  task         String // image-generation | video-generation | coding-task
  status       String // queued | running | completed | failed | rejected | unsupported
  progress     Int       @default(0)
  paramsJson   String // validated request parameters
  resultJson   String? // normalized result payload (artifact paths, metrics)
  errorCode    String?
  errorMessage String? // safe, customer-displayable message
  backendId    String? // private backend id — NEVER exposed to non-admin clients
  queuedAt     DateTime  @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ---------------------------------------------------------------------
  // BACKGROUND AI ENGINE (2026-11-07) — ADDITIVE durable-queue fields.
  // Existing columns/values are untouched; product routes keep their wire
  // contracts (extended states are normalized to the legacy vocabulary at
  // those boundaries). These fields give every job: an owning worker with a
  // time-limited claim (lease) that another worker can take over after a
  // crash, bounded retry scheduling, a duplicate-submission guard, an
  // honest error classification and a cooperative cancel flag.
  // ---------------------------------------------------------------------
  capability      String? // engine capability key (chat | text-to-image | image-editing | ...)
  workerId        String? // claiming worker instance id
  workerKind      String? // embedded (in-server) | standalone (worker process)
  leaseUntil      DateTime? // claim expiry — a stale lease means the worker died
  heartbeatAt     DateTime? // last worker liveness signal
  attempts        Int       @default(0)
  maxAttempts     Int       @default(2)
  nextRunAt       DateTime? // RETRY_WAIT scheduling (null = immediately eligible)
  errorClass      String? // rate_limited | auth | billing | timeout | network | worker_lost | permanent | cancelled | budget | none
  dedupeKey       String? // hash of user+product+task+params while a job is active
  cancelRequested Boolean   @default(false) // cooperative cancel for running jobs

  events JobEvent[]

  @@index([userId, product])
  @@index([status])
  @@index([product, status, nextRunAt])
  @@index([dedupeKey])
  @@index([leaseUntil])
}

/**
 * BACKGROUND AI ENGINE (2026-11-07) — additive append-only event log per job.
 * Workers stream partial text (chat/coding), progress, stages and research/
 * tool notices here; the SSE job-events endpoint replays them from any
 * cursor, so a client can disconnect and reattach (or never connect at all —
 * results persist regardless of who is watching).
 */
model JobEvent {
  id        String        @id @default(cuid())
  jobId     String
  seq       Int // per-job monotonic sequence
  type      String // delta | stage | progress | research | tool | reset | notice | error | artifact
  dataJson  String
  createdAt DateTime      @default(now())
  job       GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, seq])
  @@index([jobId, seq])
}

// LAXII preservation engine (2026-10-31): uploaded reference images,
// originals to enhance/edit, brush masks and produced artifacts.
// Additive table — existing models are untouched.
model ImageAsset {
  id        String   @id @default(cuid())
  userId    String
  kind      String // reference | original | mask | result
  mime      String
  width     Int?
  height    Int?
  bytes     Int
  path      String   @default("") // storage-relative path (ext from metaJson)
  metaJson  String?  // ext, provenance, pipeline metadata
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

model UsageRecord {
  id         String   @id @default(cuid())
  userId     String
  product    String
  backendId  String?
  kind       String // chat | image-generation | video-generation | coding-task
  tokensIn   Int? // estimated when provider does not report exact counts
  tokensOut  Int?
  imageCount Int?
  durationMs Int?
  costMicros Int? // null = cost data not reported by provider (never invented)
  success    Boolean  @default(true)
  errorCode  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, product])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String? // user performing the action, if authenticated
  action    String // e.g. auth.login, admin.view_backends, job.cancel
  target    String? // resource affected
  metaJson  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model CodeProject {
  id        String        @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  CodeMessage[]
  files     CodeFile[]

  @@index([userId, updatedAt])
}

model CodeMessage {
  id        String      @id @default(cuid())
  projectId String
  role      String // user | assistant
  content   String
  metaJson  String? // file changes summary (added/modified/diffs) for honest UI history
  createdAt DateTime    @default(now())
  project   CodeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model CodeFile {
  id        String      @id @default(cuid())
  projectId String
  path      String
  content   String
  origin    String      @default("generated") // generated | modified
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  project   CodeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
  @@index([projectId])
}

// RIISHE user-approved memory (explicit facts the user asked RIISHE to keep;
// per-user isolated; deleted on request — see src/lib/riishe/memory.ts).
model RiisheMemory {
  id        String   @id @default(cuid())
  userId    String
  content   String // the fact, exactly as confirmed to the user
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ---- Unified AI gateway (2026-11-04 work order) -----------------------------
// Additive tables only — existing models are untouched. All secret material
// is stored encrypted (AES-256-GCM) or hashed (SHA-256); raw secrets are
// NEVER persisted and NEVER returned by any API response.

// External PROVIDER credentials (secret type A): the admin-supplied API keys
// that let the gateway call third-party inference providers. Encrypted at
// rest with the master key from the environment; never sent to any client.
model ProviderCredential {
  id          String    @id @default(cuid())
  provider    String // registered provider id, e.g. 'openai-compatible'
  label       String // admin-chosen display label
  // AES-256-GCM payload (versioned envelope). Contains the provider API key
  // and optional endpoint overrides as JSON — readable ONLY server-side with
  // the master key, which lives outside this database.
  encrypted   String
  // Masked, display-only hint (e.g. "sk-…ab12") — no usable secret material.
  maskedHint  String
  status      String    @default("active") // active | revoked
  keyVersion  Int       @default(1) // master-key envelope version
  baseUrl     String? // endpoint override (non-secret), used by the adapter
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastUsedAt  DateTime?
  user        User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([provider, status])
}

// CODE GIFTZ APPLICATION API keys (secret type B): gateway access tokens for
// BEAN products and third-party integrations. Only a SHA-256 hash is stored;
// the complete key is shown exactly once at creation.
model ApiKey {
  id              String    @id @default(cuid())
  userId          String // owning administrator
  name            String
  prefix          String // first chars (e.g. "bgk_abcd") — lookup + masked display
  keyHash         String    @unique // SHA-256 hex of the FULL key; raw key never stored
  permissions     String    @default("[]") // JSON array of granted scopes
  rateLimitPerMin Int       @default(60)
  status          String    @default("active") // active | revoked
  expiresAt       DateTime?
  lastUsedAt      DateTime?
  requestCount    Int       @default(0)
  createdAt       DateTime  @default(now())
  revokedAt       DateTime?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([keyHash])
  @@index([userId, status])
}

// Per-request gateway diagnostics (admin-facing; no prompts, no secrets).
// Usage aggregates for metering live in UsageRecord (product 'api-gateway').
model GatewayRequestLog {
  id         String   @id @default(cuid())
  authKind   String // session | api-key
  keyId      String? // application API key id (when api-key auth)
  userId     String? // owning user of the session or key
  provider   String
  model      String
  endpoint   String
  status     Int // HTTP status returned
  errorCode  String?
  tokensIn   Int?
  tokensOut  Int?
  durationMs Int?
  streamed   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([keyId])
}

// Runtime-tunable operator settings (self-verification controls, etc.).
// JSON-string values; admins update via /api/admin/verification.
model SystemSetting {
  key       String   @id
  value     String
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// LAXII UNIFIED CONVERSATIONAL STUDIO (2026-11-12) — additive persistence for
// the one-workspace redesign. Existing GenerationJob and ImageAsset records
// are the source of truth for every artifact and job state; these tables only
// LINK to them by id (jobId / assetId), so all artifact references and
// storage paths keep working and no existing row is rewritten.
model LaxiiConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New image conversation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  LaxiiMessage[]

  @@index([userId, updatedAt])
}

model LaxiiMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String // user | assistant
  kind           String // text | job | clarify | mask-request
  text           String?
  // Optional LINKS — never copies: the referenced GenerationJob / ImageAsset
  // rows stay owned by their existing pipelines.
  assetId        String?
  jobId          String?
  maskAssetIds   String? // JSON array of mask asset ids (masked-edit flow)
  metaJson       String? // intent, engine hints, capability truth
  createdAt      DateTime @default(now())
  conversation   LaxiiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// JAZMII CONVERSATIONAL VIDEO STUDIO (2026-11-12) — additive persistence for
// the one-workspace redesign. Existing GenerationJob rows remain the source
// of truth for every video artifact and job state; these tables only LINK to
// them by id (jobId), so artifact references (/api/jazmii/jobs/<id>/media),
// provider recovery and retry logic keep working untouched.
model JazmiiConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New video conversation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  JazmiiMessage[]

  @@index([userId, updatedAt])
}

model JazmiiMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String // user | assistant
  kind           String // text | job
  text           String?
  // Optional LINK to the GenerationJob that executes (or executed) this turn.
  jobId          String?
  // Generation settings chosen in the composer for this turn (size,
  // durationSec, quality, withAudio, hasReferenceImage) — display data only;
  // the authoritative copy lives in GenerationJob.paramsJson.
  metaJson       String?
  createdAt      DateTime @default(now())
  conversation   JazmiiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
