      "checksum": "verified-at-download",
      "status": "not-downloaded"
    },
    {
      "id": "sdxl-base-1.0",
      "sourceUrl": "https://huggingface.co/stabilityai/stable-diffusion-xl-base-1.0",
      "file": "diffusers-layout directory (fp16 variants) — REQUIRED for masked inpaint; the lone sd_xl_base_1.0.safetensors single file serves txt2img only",
      "license": "CreativeML Open RAIL++-M License",
      "commercialUse": "permitted-subject-to-use-restrictions",
      "downloadSizeApproxGb": 6.9,
      "vramClassGb": 10,
      "role": "photorealistic generation / SDXL masked inpaint / PuLID host (future)",
      "checksum": "verified-at-download",
      "status": "not-downloaded"
    },
    {
      "id": "ip-adapter-h94-sd15",
      "sourceUrl": "https://huggingface.co/h94/IP-Adapter",
      "file": "models/ip-adapter_sd15.safetensors + models/image_encoder (CLIP ViT-H, downloaded for offline use)",
      "license": "Apache-2.0 (repo + weights re-release)",
      "commercialUse": "permitted",
      "downloadSizeApproxGb": 2.6,
      "vramClassGb": 2,
      "role": "reference-guided conditioning",
      "checksum": "verified-at-download",
      "status": "not-downloaded",
