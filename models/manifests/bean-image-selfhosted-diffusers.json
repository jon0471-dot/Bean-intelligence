      "checksum": "verified-at-download",
      "status": "not-downloaded"
    },
    {
      "id": "flux1-schnell",
      "sourceUrl": "https://huggingface.co/black-forest-labs/FLUX.1-schnell",
      "file": "flux1-schnell.safetensors",
      "license": "Apache-2.0 (verified 2026-10-24 in LICENSING-REPORT.md)",
      "commercialUse": "permitted",
      "downloadSizeApproxGb": 23.8,
      "vramClassGb": 24,
      "role": "CANDIDATE fast T2I tier — does not fit 16 GB at bf16; fp8/quant only after local preflight proves it. Never default",
      "checksum": "verified-at-download",
      "status": "not-downloaded"
    }
  ],
  "rejected": [
    { "id": "InstantID", "reason": "mandatory InsightFace antelopev2 face model is non-commercial research-only" },
    { "id": "h94/IP-Adapter-FaceID", "reason": "non-commercial (insightface face model) per maintainer statement 2024-01-22" },
    { "id": "FLUX.1-dev (and PuLID-FLUX)", "reason": "FLUX.1-dev Non-Commercial License" },
