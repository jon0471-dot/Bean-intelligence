{
  "manifestVersion": "1.0",
  "backendId": "bean-image-selfhosted-diffusers",
  "product": "laxii",
  "task": "image-editing",
  "status": "not-deployed",
  "deploymentMode": "self-hosted",
  "provider": "BEAN Intelligence (local Diffusers worker)",
  "modelIdentity": "Multi-component local stack — per-component identity below",
  "revision": null,
  "endpointType": "gpu-worker",
  "worker": {
    "entry": "workers/laxii-diffusers/worker.py",
    "protocol": "JSON lines over stdin/stdout; methods: preflight, health, unload, txt2img, inpaint (masked img2img via strength<1), reference_generate, identity_prepare, identity_check, upscale, object_removal",
    "requirementsFile": "workers/laxii-diffusers/requirements.txt",
    "requirementsInstalledInThisEnvironment": false,
    "localDeploymentKit": {
      "runbook": "workers/laxii-diffusers/local/ACCEPTANCE-RUNBOOK.md",
      "setup": "workers/laxii-diffusers/windows/setup.ps1",
      "hardwareReport": "workers/laxii-diffusers/windows/hardware_report.ps1",
      "downloader": "workers/laxii-diffusers/local/download_models.py",
      "acceptanceHarness": "workers/laxii-diffusers/local/run_acceptance.py",
      "targetHost": "Windows 11, RTX 5060 Ti 16 GB (Blackwell sm_120, requires torch cu128 wheels, driver >= 576.02)"
    },
    "enableGates": [
      "hardware preflight passes on the target GPU host (RTX 5060 Ti 16 GB reported target)",
      "real inference acceptance test completed and recorded in worklog.md"
    ]
  },
  "capabilities": {
    "textToImage": true,
    "imageToImage": true,
    "maskedInpaint": true,
    "referenceGuided": "IP-Adapter (h94, Apache-2.0)",
    "identityConditioning": "PuLID-SDXL (subject to SDXL OpenRAIL++-M terms)",
    "identityMetric": "YuNet (MIT) detection + SFace (provisional) cosine similarity",
    "objectRemoval": "big-lama (Apache-2.0)",
    "modelUpscale": "Real-ESRGAN x4plus (BSD-3-Clause)",
    "outputFormat": "png"
  },
  "checkpoints": [
    {
      "id": "sd15-inpaint",
      "sourceUrl": "https://huggingface.co/sd-legacy/stable-diffusion-inpainting",
      "file": "sd-v1-5-inpainting.safetensors (downloaded from the webui/stable-diffusion-inpainting mirror of the deprecated runwayml repo; official license card: sd-legacy)",
      "license": "CreativeML OpenRAIL-M",
      "commercialUse": "permitted-subject-to-use-restrictions",
      "downloadSizeApproxGb": 4.3,
      "vramClassGb": 4,
      "role": "fast inpaint / masked img2img tier",
      "checksum": "verified-at-download",
      "status": "not-downloaded"
    },
    {
      "id": "sd15-base",
      "sourceUrl": "https://huggingface.co/sd-legacy/stable-diffusion-v1-5",
      "file": "v1-5-pruned-emaonly.safetensors",
      "license": "CreativeML OpenRAIL-M",
      "commercialUse": "permitted-subject-to-use-restrictions",
      "downloadSizeApproxGb": 4.3,
      "vramClassGb": 4,
