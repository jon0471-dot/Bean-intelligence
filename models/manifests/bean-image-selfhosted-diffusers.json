      "checksum": "verified-at-download",
      "status": "not-downloaded"
    },
    {
      "id": "big-lama",
      "sourceUrl": "https://huggingface.co/smartywu/big-lama (TorchScript packaging; upstream weights: https://github.com/advimman/lama)",
      "file": "big-lama/model.jit (TorchScript, extracted from big-lama.zip)",
      "license": "Apache-2.0",
      "commercialUse": "permitted",
      "downloadSizeApproxGb": 0.2,
      "role": "object removal / large-mask structural inpaint",
      "checksum": "verified-at-download",
      "status": "not-downloaded"
    },
    {
      "id": "face-detection-yunet",
      "sourceUrl": "https://huggingface.co/opencv/face_detection_yunet",
      "file": "face_detection_yunet_2023mar.onnx",
